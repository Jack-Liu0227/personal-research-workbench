+.ol-right .at-heading h1{font-size:15px}
+.ol-right .at-heading p{font-size:11.5px;line-height:1.5}
+.ol-marks{flex:none;border-top:1px solid var(--line);padding:6px 12px 8px;max-height:150px;display:flex;flex-direction:column;gap:4px}
+.ol-marks-h{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}
+.ol-marks-h .btn{height:26px;padding:0 9px;font-size:12px}
+.ol-marks-l{display:flex;flex-wrap:wrap;gap:6px;overflow:auto}
+.ol-marks .att{font-size:11.5px}
+mark.dw-hl{padding:1px 0;border-radius:3px;color:inherit;cursor:pointer}
+.dw-pen{position:absolute;right:14px;bottom:120px;z-index:40;width:184px;background:var(--panel);border:1px solid var(--line);
+        border-radius:12px;padding:12px 14px;box-shadow:0 10px 30px rgba(0,0,0,.4);font-size:13px}
