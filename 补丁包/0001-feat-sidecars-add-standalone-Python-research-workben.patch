+.ol-head{display:flex;align-items:center;gap:8px;flex:none;height:40px;padding:0 12px;border-bottom:1px solid var(--line);font-size:13px}
+.ol-head .btn{height:28px;padding:0 10px;font-size:12px}
+.ol-tag{color:var(--muted);font-size:12px}
+.ol-spacer{flex:1}
+.ol-meta{color:var(--muted);font-size:11.5px}
+.ol-body{flex:1;min-height:0;overflow:auto;padding:14px 20px;font-size:13.5px;line-height:1.9;-webkit-user-select:text;user-select:text}
