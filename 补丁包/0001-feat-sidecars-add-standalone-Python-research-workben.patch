+/* ---- 流体统计卡（WebGL 材质；WebGL 不可用时走 .is-fallback 的 CSS 渐变，与参考插件同款降级） ---- */
+.kb-stat.kb-fluid-stat{padding:14px 16px;isolation:isolate;background:linear-gradient(145deg,rgba(14,24,22,.38),rgba(2,12,10,.16));border-color:color-mix(in srgb,var(--accent) 26%,var(--line));box-shadow:0 18px 54px rgba(0,0,0,.28),inset 0 1px 0 rgba(219,255,247,.16)}
