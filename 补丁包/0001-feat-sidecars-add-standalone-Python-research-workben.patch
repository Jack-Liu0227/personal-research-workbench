+.kb-fluid-noise{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.16;background-image:radial-gradient(rgba(225,255,248,.62) .45px,transparent .7px);background-size:4px 4px;mix-blend-mode:overlay}
+.kb-fluid-fallback{position:absolute;inset:-10%;z-index:0;pointer-events:none;opacity:.8;background:radial-gradient(circle at 82% 18%,rgba(0,231,210,.75),transparent 38%),radial-gradient(circle at 54% 94%,rgba(60,200,255,.46),transparent 48%),radial-gradient(circle at 100% 58%,rgba(7,95,104,.62),transparent 58%);filter:blur(13px);animation:kb-fluid-fallback 9s ease-in-out infinite}
+.kb-fluid-stat:not(.is-fallback) .kb-fluid-fallback{display:none}
+.kb-fluid-stat.is-fallback .kb-fluid-canvas{display:none}
+.kb-fluid-stat .kb-stat-content{position:relative;z-index:2;color:var(--stat-text,#f4f7f5);text-shadow:0 1px 8px rgba(0,0,0,var(--content-shade,.45))}
+.kb-fluid-stat .kb-stat-t,.kb-fluid-stat .kb-stat-c,.kb-fluid-stat .kb-stat-u{color:inherit;opacity:.88}
+.kb-fluid-stat .kb-stat-v{color:inherit}
+.kb-fluid-stat .kb-stat-i{color:inherit;opacity:.55;border:0}
+.kb-fluid-stat:not(.is-fallback)::before{content:"";position:absolute;inset:-20%;z-index:0;pointer-events:none;background:radial-gradient(ellipse at 76% 23%,rgba(76,255,231,.20),transparent 39%),radial-gradient(ellipse at 28% 88%,rgba(45,198,255,.15),transparent 43%);mix-blend-mode:screen;filter:blur(12px);animation:kb-fluid-breathe 5.5s ease-in-out infinite}
+@keyframes kb-fluid-breathe{50%{transform:translate(-7%,5%) scale(1.13);opacity:.55}}
+@keyframes kb-fluid-fallback{50%{transform:translate(4%,-3%) scale(1.08);opacity:.62}}
+@media (prefers-reduced-motion:reduce){.kb-fluid-stat::before,.kb-fluid-fallback{animation:none}}
