+
+  // ---------- 邮件一键翻译 ----------
+
+  /** 译文缓存。只保留当前这一封，切换邮件即失效（见 renderMailDetail） */
+  let mailTrans = null;
+  /** 单次翻译的字符上限，避免超长邮件把翻译接口拖垮 */
+  const MAIL_TRANS_MAX = 6000;
