+<!doctype html>
+<html lang="zh-CN" data-theme="dark">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>科研工作 1.0</title>
+<script>
+/* 标题带上构建戳：启动器靠它认出「哪扇窗是这一版」（app 窗口的 --app 复用不可靠） */
+document.title = "科研工作 1.0 · v" + (new URLSearchParams(location.search).get("v") || "dev");
+</script>
+<style>
+/* 主题色由 JS 从「主色」推导（抄 zotero-lit-tool 的 deriveTheme），这里只留两档明暗底 */
+:root[data-theme=dark]{--bg:#0b0f14;--panel:#111821;--panel2:#0e141b;--line:#1e2833;--fg:#e6edf5;--muted:#8b9bb0;--ok:#4ade80;--warn:#fbbf24;--err:#f87171;--shadow:0 8px 30px rgba(0,0,0,.45);--accent:#2dd4bf;--accent-ink:#04211f;--side-bg:#0e141b}
+:root[data-theme=light]{--bg:#f6f8fa;--panel:#ffffff;--panel2:#f1f4f8;--line:#dfe5ec;--fg:#16202b;--muted:#5d6b7c;--ok:#159a5a;--warn:#b07d00;--err:#c04040;--shadow:0 8px 24px rgba(16,32,52,.10);--accent:#176b87;--accent-ink:#ffffff;--side-bg:#f1f4f8}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{font:var(--app-font-size,14px)/1.55 "Segoe UI","Microsoft YaHei",system-ui,sans-serif;background:var(--bg);color:var(--fg);overflow:hidden}
+button,input,select,textarea{font:inherit;color:inherit}
+a{color:var(--accent)}
+::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:6px}
+
+.app-shell{display:flex;height:100vh}
+.sidebar{width:232px;flex:none;background:var(--side-bg,var(--panel2));border-right:1px solid var(--line);display:flex;flex-direction:column}
+.sidebar.collapsed{width:64px}
+.sidebar.collapsed .lbl,.sidebar.collapsed .sidebar-group-children,.sidebar.collapsed .swatches{display:none}
+.brand{display:flex;align-items:center;gap:10px;padding:12px 12px 10px}
+.mark{display:flex;gap:3px;align-items:flex-end;height:22px}
+.mark i{width:4px;border-radius:2px;background:var(--accent);display:block}
+.mark i:nth-child(1){height:10px;opacity:.6}.mark i:nth-child(2){height:16px;opacity:.85}.mark i:nth-child(3){height:22px}
+.brand b{font-size:16px;font-weight:700;display:block;line-height:1.15}
+.brand small{color:var(--muted);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase}
+.as-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-top:12px}
+.as-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;cursor:pointer;transition:border-color .18s,transform .18s}
+.as-card:hover{border-color:var(--accent)}
+.as-card.off{opacity:.55}
+.as-card-top{display:flex;align-items:flex-start;justify-content:space-between}
+.as-card b{display:block;margin-top:12px;font-size:14px;font-weight:600;color:var(--text)}
+.as-card p{margin:6px 0 0;font-size:12px;line-height:1.5;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.9em}
+.as-card-foot{margin-top:14px;display:flex;align-items:center;gap:8px}
+.as-card-foot .as-go{opacity:0;transition:opacity .18s}
+.as-card:hover .as-card-foot .as-go{opacity:1}
+.as-av{display:inline-flex;align-items:center;justify-content:center;border-radius:12px;background:var(--panel2);border:1px solid var(--line)}
+.as-dot{width:8px;height:8px;border-radius:50%;background:var(--line);flex:none;margin-top:4px}
+.as-dot.on{background:var(--accent)}
+.as-form{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px;margin-top:8px}
+.as-form .field{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
+.as-card + .as-card{}
+
+/* 个人资料卡片（照 lit 侧栏卡片，只显示头像 + 用户名） */
+.profile-card{display:flex;align-items:center;gap:10px;margin:8px 10px 4px;padding:9px 11px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;cursor:pointer;transition:background .15s}
+.profile-card:hover{background:color-mix(in srgb,var(--accent) 12%,transparent)}
+.profile-avatar{display:flex;width:36px;height:36px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:var(--panel);border:1px solid var(--line);font-size:19px}
+.profile-info{display:flex;min-width:0;flex:1;flex-direction:column}
+.profile-info b{overflow:hidden;font-size:14px;text-overflow:ellipsis;white-space:nowrap}
+.profile-edit{color:var(--muted);font-size:12px}
+.sidebar.collapsed .profile-card{justify-content:center;padding:9px 0}
+.sidebar.collapsed .profile-info,.sidebar.collapsed .profile-edit{display:none}
+.collapse{margin-left:auto;background:none;border:1px solid var(--line);border-radius:6px;width:24px;height:24px;color:var(--muted);cursor:pointer}
+.nav{padding:4px 8px;overflow:auto;flex:1}
+.nav-item{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:8px 10px;border:0;border-radius:8px;background:none;cursor:pointer;color:var(--fg);margin-bottom:2px}
+.nav-item:hover{background:color-mix(in srgb,var(--accent) 12%,transparent)}
+.nav-item.active{background:color-mix(in srgb,var(--accent) 20%,transparent);box-shadow:inset 2px 0 0 var(--accent);font-weight:600}
+.nav-ico{width:20px;flex:none;text-align:center;font-size:15px;line-height:1;font-family:"Segoe UI Emoji","Segoe UI Symbol",var(--app-font,inherit)}
+.sidebar-group{margin-top:6px}
+.sidebar-group>.nav-item{color:var(--muted);font-size:12.5px}
+.chev{margin-left:auto;transition:transform .15s}
+.chev.open{transform:rotate(180deg)}
+.sidebar-foot{border-top:1px solid var(--line);padding:8px}
+.online{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);padding:6px 10px}
+.dot{width:6px;height:6px;border-radius:50%;background:var(--ok)}
+
+.content{flex:1;display:flex;flex-direction:column;min-width:0}
+.topbar{height:46px;flex:none;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--panel)}
