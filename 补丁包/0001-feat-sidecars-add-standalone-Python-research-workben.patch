+.ol-right{position:relative}
+body.dw-pen-on .ol-body{cursor:text}
+body.dw-pen-on .ol-body ::selection{background:color-mix(in srgb,var(--accent) 40%,transparent)}
+@media (max-width:1150px){ .ol-grid{grid-template-columns:minmax(0,1fr)} .ol-right{display:none} }
+
+.tr-note{display:grid;grid-template-columns:minmax(0,3fr) minmax(300px,1fr);gap:12px;height:100%;padding:10px;box-sizing:border-box}
+.tr-note-l,.tr-note-r{border:1px solid var(--line);border-radius:10px;background:var(--panel);display:flex;flex-direction:column;min-width:0;overflow:hidden}
+.tr-note-h{flex:none;padding:8px 12px;border-bottom:1px solid var(--line);color:var(--muted);font-size:12px}
+.tr-note-body{flex:1;min-height:0;overflow:auto;padding:12px 18px;font-size:13.5px}
+.tr-note-title{margin:10px 12px 4px;padding:8px 10px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--fg);font:inherit;font-size:14px;font-weight:600}
+.tr-note-hint{padding:0 12px 8px;color:var(--muted);font-size:11px}
+.tr-note-src{flex:1;min-height:0;margin:0 12px 12px;padding:10px 12px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--fg);font:13.5px/1.75 inherit;resize:none}
+.tr-load{padding:22px;color:var(--muted)}
+.tr-load.err{color:var(--err)}
+/* ==================== 开始卡片（splash）：地球 + 标题字 + 「进入」 ==================== */
+#splash{position:fixed;inset:0;z-index:9000;background:#0B0C0E;overflow:hidden;opacity:0;pointer-events:none;transition:opacity .42s ease}
+#splash.ready{opacity:1;pointer-events:auto}
+#splash.out{opacity:0}
+#splash .sp-globe{position:absolute;left:0;right:0;top:-12.7%;height:79%;width:100%;display:block;touch-action:none;user-select:none}
+#splash .sp-word{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}   /* 字标铺满整卡：手柄三角/坐标标签要有原组件的空间比例；不吃指针事件，地球才拖得动 */
+/* 「Enter」= magicui Interactive Hover Button 照抄：胶囊 + 圆点；悬停时圆点放大填满、文字右移淡出、覆盖层(文字+箭头)滑入 */
+#splash .sp-go{position:absolute;left:50%;top:86%;transform:translate(-50%,-50%);display:block;width:auto;padding:12px 36px;border:1px solid var(--line);border-radius:9999px;background:linear-gradient(180deg,var(--bg) 0%,color-mix(in srgb,var(--bg) 44%,#0B0C0E) 100%);color:var(--fg);font:800 24px/1 "Inter","Segoe UI","Microsoft YaHei",system-ui,sans-serif;letter-spacing:-0.02em;text-align:center;cursor:pointer;overflow:hidden}   /* top =（标题行 71.9% + 卡底 100%）/2；字体/字重/字距与字标同一套 */
+#splash .sp-in{display:flex;align-items:center;justify-content:center;gap:12px}
+#splash .sp-dot{width:12px;height:12px;flex:none;border-radius:9999px;background:linear-gradient(180deg,var(--accent) 47.9%,color-mix(in srgb,var(--accent) 44%,#0B0C0E) 52.1%);transition:all .3s}   /* 蓝态=字标同款纵向渐变。圆点要 scale(100.8) 放大到 ~1210px 去填胶囊，所以渐变只占 47.9~52.1% 这一小段 —— 放大后刚好铺满 49px 的胶囊高度（胶囊高度变了要同步改这两个数） */
+#splash .sp-go:hover .sp-dot{transform:scale(100.8)}
+#splash .sp-lb{display:inline-block;background:linear-gradient(180deg,var(--fg) 0%,color-mix(in srgb,var(--fg) 62%,var(--bg)) 100%);-webkit-background-clip:text;background-clip:text;color:transparent;transition:all .3s}
+#splash .sp-go:hover .sp-lb{transform:translateX(48px);opacity:0}
+#splash .sp-hv{position:absolute;left:0;top:0;z-index:10;display:flex;align-items:center;justify-content:center;gap:12px;width:100%;height:100%;color:var(--accent-ink);opacity:0;transform:translateX(48px);transition:all .3s;pointer-events:none}
+#splash .sp-go:hover .sp-hv{transform:translateX(-20px);opacity:1}
+#splash .sp-hv span{background:linear-gradient(180deg,var(--accent-ink) 0%,color-mix(in srgb,var(--accent-ink) 62%,var(--accent)) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
+#splash .sp-hv svg{width:27px;height:27px;flex:none}
+#splash .sp-close{position:absolute;right:10px;top:8px;width:34px;height:34px;border:0;background:none;color:#fff;opacity:.3;font:400 18px/1 "Segoe UI",sans-serif;cursor:pointer;transition:opacity .2s}
+#splash .sp-close:hover{opacity:.85}
+/* ==================== 知识库（Obsidian 看板；版式照 Baixiao-Reading-Cockpit） ==================== */
+.kb-page{display:flex;flex-direction:column;gap:12px;padding-bottom:8px}
