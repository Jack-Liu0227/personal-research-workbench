+.kb-stat-t{color:var(--muted);font-size:12px}
+.kb-stat-v{font-size:26px;font-weight:700;line-height:1.15}
+.kb-stat-u{color:var(--muted);font-size:11px;margin-left:5px}
+.kb-stat-c{color:var(--muted);font-size:11px;margin-top:2px}
+.kb-stat-i{position:absolute;right:12px;top:10px;font-size:17px;color:var(--accent);opacity:.55}
+.kb-stat.kb-slim .kb-stat-v{font-size:22px}
+.kb-board{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr) minmax(0,.95fr);gap:12px;align-items:start}
