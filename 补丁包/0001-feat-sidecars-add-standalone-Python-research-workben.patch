+# ---------------- 引用台账（后台 markdown：正文里不写标号，引用全记在这） ----------------
+CITE_FILE = "引用台账.md"
+CITE_JSON = "引用台账.json"
+
+
+def cite_paths(db: "WorkflowDB", task_id: str) -> tuple[Path, Path]:
+    return _doc_fallback(db, task_id, CITE_FILE), _doc_fallback(db, task_id, CITE_JSON)
+
