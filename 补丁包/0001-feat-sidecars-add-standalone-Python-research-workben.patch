+def _cite_load(db: "WorkflowDB", task_id: str) -> list[dict[str, Any]]:
+    _, js = cite_paths(db, task_id)
+    try:
+        data = json.loads(js.read_text(encoding="utf-8"))
+        return data if isinstance(data, list) else []
+    except Exception:
+        return []
