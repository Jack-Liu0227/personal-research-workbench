+  if(stage==="write"){ body.section=$("in-sec").value; body.title=$("in-title").value; }
+  if(stage==="convert") body.format=$("in-fmt").value;
+  if(btn){btn.disabled=true;const o=btn.textContent;btn.textContent="运行中…";btn.dataset.o=o;}
+  out.className=""; out.innerHTML=`<div class="hint">正在执行…（模型步骤可能较久）</div>`;
+  try{
+    const r=await api("/api/workflow/"+stage,body);
+    out.innerHTML=resultHtml(stage,r);
+    if(stage==="download" && (r.paper?.id)){          // 下载即精读，少点一次
