+# -*- coding: utf-8 -*-
+"""精读相关纯函数自检：非论文过滤 + 检索相关度粗筛。
+
+    python -m unittest test_deepread -v
+"""
+from __future__ import annotations
+
+import os
+import pathlib
+import tempfile
+import unittest
+
+os.environ.setdefault("RESEARCH_WORKBENCH_DB", str(pathlib.Path(tempfile.gettempdir()) / "dr_unit.sqlite3"))
+
+import workflow  # noqa: E402
+
+
+class DeepreadTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.d = pathlib.Path(tempfile.mkdtemp(prefix="dr_"))
+        # 一篇「真论文」：够大、没有同名 .tex
+        self.paper = self.d / "s41586-024-08328-6.pdf"
+        self.paper.write_bytes(b"%PDF-1.4" + b"x" * 30000)
+        # 各种建产物/残件
+        (self.d / "main_zh.pdf").write_bytes(b"%PDF-1.4" + b"x" * 30000)
+        (self.d / "main_zh.tex").write_text("\\documentclass{revtex4-1}", encoding="utf-8")
+        (self.d / "tiny.pdf").write_bytes(b"%PDF-1.4" + b"x" * 100)
+        (self.d / "_build").mkdir()
+        (self.d / "_build" / "main.pdf").write_bytes(b"%PDF-1.4" + b"x" * 30000)
+        (self.d / "overleaf").mkdir()
+        (self.d / "overleaf" / "main.pdf").write_bytes(b"%PDF-1.4" + b"x" * 30000)
+
+    def test_01_only_real_papers_pass(self):
+        self.assertTrue(workflow.is_paper_pdf(self.paper))                 # 真论文
+        self.assertFalse(workflow.is_paper_pdf(self.d / "main_zh.pdf"))    # 旁边有 .tex → 编出来的
+        self.assertFalse(workflow.is_paper_pdf(self.d / "tiny.pdf"))       # 太小
+        self.assertFalse(workflow.is_paper_pdf(self.d / "_build" / "main.pdf"))
+        self.assertFalse(workflow.is_paper_pdf(self.d / "overleaf" / "main.pdf"))
+        self.assertFalse(workflow.is_paper_pdf(self.d / "不存在.pdf"))      # 不存在也算不算
+
+    def test_02_relevance_filter(self):
+        q = "materials informatics machine learning doping"
+        good = {"title": "Machine learning for materials informatics in doped cathodes", "abstract": ""}
+        junk = {"title": "Teacher materials Volume 1", "abstract": ""}
+        self.assertTrue(workflow._relevant(q, good))
+        self.assertFalse(workflow._relevant(q, junk))                      # 只蹭到一个词 → 挡掉
+        self.assertTrue(workflow._relevant(q, {"title": "Machine learning review", "abstract": "doping in materials"}))
+        self.assertTrue(workflow._relevant("doping", junk))                # 关键词本来就少 → 不过滤
+
+    def test_03_vocab_and_stop_exception_exist(self):
+        self.assertTrue(hasattr(workflow, "DeepreadStopped"))
+        self.assertTrue(hasattr(workflow, "deepread_kick"))
+        self.assertTrue(hasattr(workflow, "deepread_stop"))
+        self.assertIsNone(workflow.deepread_state("no-such-task"))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/sidecars/research-workbench-py/test_guards.py b/sidecars/research-workbench-py/test_guards.py
new file mode 100644
index 0000000..71030b1
--- /dev/null
+++ b/sidecars/research-workbench-py/test_guards.py
@@ -0,0 +1,65 @@
+"""两个闸门的自检：出站脱敏不能误伤科研文本，引用核验要能把编的引用抓出来。"""
+import unittest
+
+import guards
+
+
+class PrivacyGateTest(unittest.TestCase):
+    def test_redacts_pii_keeps_science(self) -> None:
+        msg = [{"role": "user", "content": "联系 13812345678 或 zhangsan@xjtu.edu.cn。"
+                                           "DOI 10.1016/j.jes.2026.122995，样品 NaNi1/3Fe1/3Mn1/3O2，"
+                                           "页码 122995，年份 2026，批号 2024 0912 3311 8877。"}]
+        hits = guards.scrub(msg)
+        c = msg[0]["content"]
+        self.assertIn("手机号", hits)
+        self.assertIn("邮箱", hits)
+        self.assertNotIn("13812345678", c)
+        self.assertNotIn("zhangsan@xjtu.edu.cn", c)
+        # 科研文本一律不许被打码
+        self.assertIn("10.1016/j.jes.2026.122995", c)
+        self.assertIn("NaNi1/3Fe1/3Mn1/3O2", c)
+        self.assertIn("122995", c)
+        self.assertIn("2026", c)
+
+    def test_redacts_secrets(self) -> None:
+        msg = [{"role": "system", "content": "key sk-abcdefghijklmnop12345678 和 "
+                                             "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\n-----END RSA PRIVATE KEY-----"}]
+        hits = guards.scrub(msg)
+        self.assertIn("密钥", hits)
+        self.assertIn("私钥", hits)
+        self.assertNotIn("sk-abcdefghijklmnop12345678", msg[0]["content"])
+        self.assertNotIn("MIIEowIBAAKCAQEA", msg[0]["content"])
+
+
+class CiteGateTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.draft = ("# 正文\n\n## 1 引言\nCu 掺杂能提升循环保持率[1]，见 Smith et al., 2024 的结论。\n"
+                      "锚句在这里摆着。\n")
+        self.entries = [
+            {"anchor": "锚句在这里摆着。", "title": "A real paper on NaNFM", "doi": "10.1016/j.jes.2026.122995",
+             "paper_id": "p1"},
+            {"anchor": "这句正文里没有", "title": "Fake Nature paper", "doi": "10.1038/fake.2026.9"},
+            {"anchor": "锚句在这里摆着。", "title": "", "doi": "", "url": ""},
+        ]
+        self.papers = [{"id": "p1", "title": "A real paper on NaNFM", "doi": "10.1016/j.jes.2026.122995",
+                        "filename": "a.pdf", "pages": 12}]
+
+    def test_catches_fabrication(self) -> None:
+        r = guards.audit(self.draft, self.entries, self.papers)
+        codes = [b["code"] for b in r["bad"]]
+        self.assertEqual(r["total"], 3)
+        self.assertEqual(r["inline"], 2)                    # [1] 和 Smith et al., 2024 都该抓到
+        self.assertIn("ANCHOR", codes)                      # C2 锚句对不上
+        self.assertIn("NOTINLIB", codes)                    # C2 的 DOI 库里没有 = 疑似编造
+        self.assertIn("NOSOURCE", codes)                    # C3 什么落点都没给
+        self.assertNotIn("C1", [b["where"] for b in r["bad"]])   # C1 是真引用，不许误报
+
+    def test_clean_draft_passes(self) -> None:
+        r = guards.audit("锚句在这里摆着。\n", [self.entries[0]], self.papers)
+        self.assertEqual(r["bad"], [])
+        self.assertIn("全部对得上号", guards.report(r))
+        self.assertIn("全部对得上号", guards.audit_block(r))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
