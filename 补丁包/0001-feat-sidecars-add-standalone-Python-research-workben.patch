+.cv-fmts{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
+.cv-fmts label{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel2);color:var(--muted);font-size:12.5px;cursor:pointer}
+.cv-fmts label.on{border-color:var(--accent);color:var(--fg)}
+.cv-fmts input{accent-color:var(--accent)}
+.cv-spacer{flex:1}
+.cv-msg{font-size:12px;color:var(--muted);max-width:46ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.cv-grid{display:grid;grid-template-columns:minmax(170px,22fr) minmax(0,50fr) minmax(230px,28fr);gap:10px;flex:1;min-height:0}
+.cv-col{border:1px solid var(--line);border-radius:10px;background:var(--panel);display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden}
+.cv-h{display:flex;align-items:center;gap:8px;flex:none;height:36px;padding:0 10px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--muted)}
+.cv-ib{height:24px;padding:0 8px;border:1px solid var(--line);border-radius:6px;background:var(--panel2);color:var(--fg);font-size:12px;cursor:pointer}
+.cv-tag{font-size:11.5px;color:var(--muted);max-width:16ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.cv-list{flex:1;min-height:0;overflow:auto;padding:6px}
+.cv-g{padding:6px 6px 2px;font-size:11.5px;color:var(--muted)}
+.cv-f{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:7px;font-size:12.5px;color:var(--fg);cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.cv-f:hover{background:var(--panel2)}
+.cv-f.on{background:color-mix(in srgb,var(--accent) 18%,transparent);border:1px solid var(--accent)}
+.cv-ext{flex:none;width:26px;text-align:center;font-size:10.5px;color:var(--muted);text-transform:uppercase}
+.cv-none{color:var(--muted);font-size:12.5px;padding:10px}
+.cv-src{flex:1;min-height:0;margin:0;padding:12px 14px;border:0;background:transparent;color:var(--fg);
+        font:12.5px/1.65 ui-monospace,Consolas,"Courier New",monospace;resize:none;outline:none;-webkit-user-select:text;user-select:text}
+.cv-frame{flex:1;min-height:0;border:0;background:#fff}
+.cv-empty{flex:none;padding:10px 12px;color:var(--muted);font-size:12px;line-height:1.7}
+
+/* ---- 确认大纲：左 2/3 框架 + 右 1/3 框架 agent（聊天壳沿用创新点审查那套 at-* 样式）---- */
+.ol-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(340px,1fr);gap:12px;height:100%;min-height:0}
