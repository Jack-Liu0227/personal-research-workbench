+      if (item && !item.seen) {
+        item.seen = true;
+        api(`/api/mail/accounts/${id}/messages/${uid}/seen`, {
+          method: 'POST', headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ seen: true, folder: mailCur.folder }),
