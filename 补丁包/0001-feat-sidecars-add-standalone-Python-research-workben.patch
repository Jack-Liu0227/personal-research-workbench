+def conv_open(path: str) -> dict[str, Any]:
+    """用系统默认程序打开（预览窗口右上那个 ↗）。"""
+    p = _safe_path(path)
+    if not p.is_file():
+        raise ValueError("文件不存在")
+    if hasattr(os, "startfile"):
+        os.startfile(str(p))                      # noqa: S606  Windows 专用，够用
+        return {"opened": str(p)}
+    raise RuntimeError("这个系统没有 startfile")
+
