+.kb-head h2{margin:0;font-size:20px;line-height:1.2}
+.kb-head p{margin:3px 0 0;color:var(--muted);font-size:12px}
+.kb-actions{margin-left:auto;display:flex;align-items:center;gap:10px}
+.kb-search{display:flex;align-items:center;gap:8px;height:36px;padding:0 12px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;color:var(--muted)}
+.kb-search input{width:230px;height:100%;border:0;background:none;outline:none;color:var(--fg)}
+.kb-actions .btn{height:36px;display:inline-flex;align-items:center}
+.kb-vault{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;font-size:13px}
